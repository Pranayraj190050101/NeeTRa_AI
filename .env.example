# ============================================================================
# NEETra AI
# Your Personal NEET Doubt Solver, Practice Partner and Rank Improver
#
# Copy this file to:
#   .env
#
# For local development (recommended):
#   LLM_PROVIDER=groq
#   GROQ_MODEL=qwen/qwen3.8-27b
#
# Never commit .env to Git.
# ============================================================================


# ============================================================================
# APPLICATION
# ============================================================================

NEET_APP_NAME=NEETra AI
NEET_APP_TAGLINE=Every NEET Doubt. One Wish Away.

NEET_LOG_LEVEL=INFO
NEET_LOG_TO_FILE=true


# ============================================================================
# LLM PROVIDER
# ============================================================================

# Supported:
#   groq
#   huggingface
#   mock

LLM_PROVIDER=groq

# Legacy support
NEET_LLM_BACKEND=hf


# ============================================================================
# GROQ
# ============================================================================

# Example:
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxx

GROQ_API_KEY=gsk_your_groq_api_key_here

# Recommended:
# qwen/qwen3.8-27b

# Alternatives:
# llama-3.3-70b-versatile
# deepseek-r1-distill-llama-70b

GROQ_MODEL=qwen/qwen3.8-27b

GROQ_TEMPERATURE=0.2
GROQ_TOP_P=0.9
GROQ_MAX_TOKENS=2048


# ============================================================================
# HUGGING FACE (LOCAL MODELS)
# ============================================================================

NEET_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Smaller models:
# Qwen/Qwen2.5-3B-Instruct
# Qwen/Qwen2.5-1.5B-Instruct

NEET_LLM_DEVICE=auto
NEET_LLM_DTYPE=auto
NEET_LLM_LOAD_IN_4BIT=false

NEET_LLM_MAX_NEW_TOKENS=768
NEET_LLM_MAX_INPUT_TOKENS=4096

NEET_LLM_TEMPERATURE=0.2
NEET_LLM_TOP_P=0.9
NEET_LLM_REPETITION_PENALTY=1.05

# Required only for gated HF repos
NEET_HF_TOKEN=


# ============================================================================
# EMBEDDINGS
# ============================================================================

# Recommended:
# sentence-transformers/all-MiniLM-L6-v2

NEET_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEET_EMBEDDING_DEVICE=auto
NEET_EMBEDDING_BATCH_SIZE=32


# ============================================================================
# PROJECT PATHS
# ============================================================================

NEET_DATA_DIR=data
NEET_VECTOR_STORE_DIR=vectordb
NEET_VECTOR_STORE_NAME=neet_index

NEET_PROMPT_DIR=prompts
NEET_LOG_DIR=logs
NEET_PROGRESS_DIR=progress


# ============================================================================
# KNOWLEDGE BASE
# ============================================================================

# RAG Source folders

NEET_KB_DIR=data/knowledge_base
NEET_PDF_DIR=data/pdfs
NEET_DOCS_DIR=data/docs

# Future expansion:
# NCERT
# Allen
# Aakash
# PYQs
# Formula Books


# ============================================================================
# RETRIEVAL
# ============================================================================

NEET_CHUNK_SIZE=900
NEET_CHUNK_OVERLAP=150
NEET_MIN_CHUNK_CHARS=80

NEET_TOP_K=5
NEET_FETCH_K=20

# Minimum retrieval confidence

NEET_SCORE_THRESHOLD=0.15

NEET_CONTEXT_CHAR_BUDGET=6000


# ============================================================================
# HYBRID SEARCH (FUTURE)
# ============================================================================

NEET_HYBRID_SEARCH_ENABLED=false

# When average retrieval confidence falls below:
NEET_HYBRID_THRESHOLD=0.55

# Future providers:
# tavily
# serpapi
# google

NEET_WEB_SEARCH_PROVIDER=mock


# ============================================================================
# CHAT BEHAVIOUR
# ============================================================================

NEET_HISTORY_TURNS=4

NEET_MAX_QUESTION_CHARS=2000
NEET_MAX_ANSWER_CHARS=6000

NEET_ALLOW_GENERAL_FALLBACK=true

NEET_STREAM_TOKENS=true


# ============================================================================
# SYSTEM PROMPT & PERSONA
# ============================================================================

NEET_PERSONA_ENABLED=true

# detailed
# quick_revision
# mcq_practice
# pyq_focus

NEET_ANSWER_MODE=detailed

NEET_ENFORCE_ANSWER_FORMAT=true


# ============================================================================
# ASK GENIE
# ============================================================================

ASK_GENIE_NCERT_PRIORITY=true

ASK_GENIE_SHOW_REASONING=true

ASK_GENIE_SHOW_NEET_TIPS=true

ASK_GENIE_SHOW_COMMON_MISTAKES=true


# ============================================================================
# PRACTICE & MOCK TESTS
# ============================================================================

NEET_MCQ_COUNT=5

NEET_TEST_QUESTION_COUNT=5

NEET_MARKS_CORRECT=4.0
NEET_MARKS_INCORRECT=-1.0


# ============================================================================
# REVISION
# ============================================================================

NEET_REVISION_WEAK_TOPIC_PRIORITY=true

NEET_REVISION_MAX_TOPICS=10


# ============================================================================
# PROGRESS TRACKING
# ============================================================================

NEET_WEAK_ACCURACY_THRESHOLD=0.75

NEET_PROGRESS_AUTO_SAVE=true

NEET_PROGRESS_KEEP_BACKUPS=true


# ============================================================================
# PLATFORM FEATURES
# ============================================================================

NEET_PLATFORM_ENABLED=true

# Hidden by default for product focus
# Can be enabled anytime

NEETRA_ENABLE_LEARN=false


# ============================================================================
# OCR / IMAGE DOUBT SOLVING (FUTURE)
# ============================================================================

NEET_IMAGE_DOUBTS_ENABLED=false

NEET_OCR_PROVIDER=mock


# ============================================================================
# GRADIO
# ============================================================================

NEET_GRADIO_SERVER_NAME=127.0.0.1

NEET_GRADIO_SERVER_PORT=7860

NEET_GRADIO_SHARE=false


# ============================================================================
# SECURITY
# ============================================================================

# Trust FAISS indexes built by this application

NEET_FAISS_ALLOW_DANGEROUS_DESERIALIZE=true

# Hide internal diagnostic information

NEET_SHOW_INTERNAL_ERRORS=false


# ============================================================================
# EXPERIMENTAL
# ============================================================================

NEET_ENABLE_TELEMETRY=false

NEET_ENABLE_QUERY_CACHE=true

NEET_ENABLE_RESPONSE_CACHE=false


# ============================================================================
# DEVELOPMENT PROFILE (RECOMMENDED)
# ============================================================================

# LLM_PROVIDER=groq
# GROQ_MODEL=qwen/qwen3.8-27b
# NEET_PLATFORM_ENABLED=true
# NEETRA_ENABLE_LEARN=true
